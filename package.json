{
  "name": "openclaw-plugin-zcode-workflow",
  "version": "0.1.2",
  "description": "ZCode-style programmatic constraint workflows (dynamic workflows) for OpenClaw: typed TS workflow scripts orchestrating subagents, with /workflow skill command.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build",
    "plugin:validate": "openclaw plugins validate --root . --entry ./dist/index.js",
    "test": "node --test dist-test/smoke.test.mjs 2>/dev/null || node test/smoke.mjs"
  },
  "dependencies": {
    "typebox": "^1.4.7",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.1"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.4"
    },
    "build": {
      "openclawVersion": "2026.11.5"
    },
    "files": [
      "dist",
      "skills",
      "openclaw.plugin.json",
      "README.md",
      "LICENSE"
    ]
  },
  "license": "MIT"
}
